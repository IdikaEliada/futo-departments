{
  "name": "futo-departments",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "build:js": "turbo run build --filter=@idikaeliada/futo-departments",
    "build:py": "cd packages/python && python -m build",
    "build:php": "",
    "test:js": "turbo run test --filter=@idikaeliada/futo-departments",
    "test:py": "cd packages/python && python -m pytest"
  },
  "devDependencies": {
    "mlly": "^1.8.2",
    "tsx": "^4.21.0",
    "turbo": "^2.9.1",
    "vite": "^8.0.3"
  }
}
