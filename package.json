{
  "name": "futo-departments",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:js": "npm run build --workspace=packages/js",
    "test:js": "npm run test --workspace=packages/js"
  }
}