    "version": "1.0.0",
    "autoload": {
        "psr-4": {
            "Idikaelaida\\FutoDepartments\\": "src/"
        }
    },
     "autoload-dev": {
    "psr-4": {
      "Idikaeliada\\FutoDepartments\\Tests\\": "tests/"
    }
  },
    "authors": [
        {
            "name": "IdikaEliada",
            "email": "idika1996@gmail.com",
            "homepage": "http://github/idikaeliada",
            "role": "Developer"
        }
